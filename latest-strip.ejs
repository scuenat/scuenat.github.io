<%
// Home-page "Latest writing" (index.qmd, fr/index.qmd): the newest post as a large feature
// (image left, text right), then the next ones as a row of image cards.
// Card markup and styles: see the site-design skill (.post-card in styles.scss).
const p = (typeof templateParams !== "undefined" && templateParams) || {};
const labels = Object.assign({ essay: "Essay", analysis: "Analysis", note: "Note", position: "Position paper", overview: "Overview" }, p.kinds || {});
const card = (item, feature) => {
  const kind = labels[item.kind] ? item.kind : null;
  const sum = item.subtitle || item.description;
  return { kind, sum, feature };
};
%>
<div class="post-latest">
<% items.forEach((item, i) => { const c = card(item, i === 0); %>
<% if (i === 1) { %><div class="post-grid post-grid-3"><% } %>
<article class="post-card<%= c.feature ? ' is-feature' : '' %>" <%= metadataAttrs(item) %>>
<% if (item.image) { %><div class="post-card-media"><img src="<%- item.image %>" alt="" onload="this.classList.toggle('is-tall', this.naturalHeight > this.naturalWidth * .8)" loading="<%= c.feature ? 'eager' : 'lazy' %>"></div><% } %>
<div class="post-card-body">
<p class="post-card-meta"><% if (c.kind) { %><span class="post-card-kind kind-<%= c.kind %>"><%= labels[c.kind] %></span><% } %><span class="post-card-date"><%= item.date %></span></p>
<h3 class="no-anchor post-card-title"><a href="<%- item.path %>"><%= item.title %></a></h3>
<% if (c.sum) { %><p class="post-card-summary"><%= c.sum %></p><% } %>
<% if (item['reading-time']) { %><p class="post-card-foot"><%= item['reading-time'] %></p><% } %>
</div>
</article>
<% }); %>
<% if (items.length > 1) { %></div><% } %>
</div>
